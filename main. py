    # ---------------------------------------------------------- ESP32 (WiFi/TCP)
    def start_esp32_server(self):
        try:
            my_ip = socket.gethostbyname(socket.gethostname())
        except Exception:
            my_ip = "unknown"
        self.center.net_lbl.text = f"ESP32 server: {my_ip}:{SERVER_PORT} (waiting...)"
        threading.Thread(target=self._server_loop, daemon=True).start()

    def _server_loop(self):
        server_sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        server_sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            server_sock.bind(("0.0.0.0", SERVER_PORT))
            server_sock.listen(5)
        except Exception as e:
            self.esp_queue.put(("ERROR", str(e)))
            return
        while True:
            client_sock, addr = server_sock.accept()
            self.esp_queue.put(("CONNECTED", addr[0]))
            threading.Thread(target=self._handle_client, args=(client_sock, addr), daemon=True).start()

    def _handle_client(self, client_sock, addr):
        buffer = ""
        with client_sock:
            while True:
                try:
                    data = client_sock.recv(1024)
                except Exception:
                    break
                if not data:
                    break
                buffer += data.decode(errors="ignore")
                while "\n" in buffer:
                    line, buffer = buffer.split("\n", 1)
                    line = line.strip()
                    if line:
                        self.esp_queue.put(("MSG", line))
        self.esp_queue.put(("DISCONNECTED", addr[0]))

    def poll_esp32_queue(self, dt):
        try:
            while True:
                kind, payload = self.esp_queue.get_nowait()
                if kind == "CONNECTED":
                    self.connected_devices += 1
                    self.center.net_lbl.text = f"ESP32 connected: {payload} (online: {self.connected_devices})"
                elif kind == "DISCONNECTED":
                    self.connected_devices = max(0, self.connected_devices - 1)
                    self.center.net_lbl.text = f"ESP32 disconnected (online: {self.connected_devices})"
                elif kind == "ERROR":
                    self.center.net_lbl.text = f"Server error: {payload}"
                elif kind == "MSG":
                    self._process_esp_message(payload)
        except queue.Empty:
            pass

    def _process_esp_message(self, line):
        line = line.upper()
        if ":" not in line:
            return
        player, action = [x.strip() for x in line.split(":", 1)]
        if player not in ("A", "B"):
            return
        if action == "HIT":
            self.register_hit(player)
        elif action == "PENALTY":
            self.register_penalty(player)


